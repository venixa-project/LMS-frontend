# ============================================================
# VeniLearn LMS — Public Internet Production (.env.production)
# ============================================================
VITE_APP_ENV=production

# Relative API routing (Nginx/Caddy terminates SSL on 443 and routes /api/v1)
VITE_API_BASE_URL=/api/v1
VITE_SOCKET_URL=/

# Public Internet Domain (Globally trusted Let's Encrypt / Certbot SSL)
VITE_PUBLIC_HTTPS_URL=https://lms.venilearn.org

# Dual-environment fallback for on-campus LAN fast route
VITE_COLLEGE_LAN_HTTPS_URL=https://lms-lan.college.edu

VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:5000
VITE_AI_PROXY_TARGET=http://127.0.0.1:8000

