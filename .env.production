# ============================================================
# VeniLearn LMS — Production Environment (.env.production)
# Automatically loaded by Vite during `npm run build`
# ============================================================
VITE_APP_ENV=production

# Deployed Railway Backend API & WebSocket URLs
VITE_API_BASE_URL=https://lms-backend-production-049db03c.up.railway.app/api/v1
VITE_API_URL=https://lms-backend-production-049db03c.up.railway.app/api/v1
VITE_SOCKET_URL=https://lms-backend-production-049db03c.up.railway.app

# Deployed Public Frontend Domain
VITE_PUBLIC_HTTPS_URL=https://venilearn.venixa.co.in

# Proxy targets (used only if running `vite preview`)
VITE_BACKEND_PROXY_TARGET=https://lms-backend-production-049db03c.up.railway.app
VITE_AI_PROXY_TARGET=http://127.0.0.1:8000
