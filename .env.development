# ============================================================
# VeniLearn LMS — Development Environment (.env.development)
# ============================================================
VITE_APP_ENV=development

# Relative API routing through Vite dev proxy (eliminates CORS / Mixed Content)
VITE_API_BASE_URL=/api/v1
VITE_API_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000

# Backend & AI Proxy targets
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:5000
VITE_AI_PROXY_TARGET=http://127.0.0.1:8000

# Optional local HTTPS certificate paths (mkcert)
# VITE_SSL_KEY=./certs/localhost-key.pem
# VITE_SSL_CERT=./certs/localhost.pem

