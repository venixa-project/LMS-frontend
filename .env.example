# ============================================================
# VeniLearn LMS — Environment Configuration Template (.env.example)
# ============================================================
VITE_APP_ENV=development

# Relative API Base URL (avoids CORS and mixed content)
VITE_API_BASE_URL=/api/v1
VITE_API_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000

# College LAN Trusted HTTPS URL (e.g. internal DNS hostname)
VITE_COLLEGE_LAN_HTTPS_URL=https://lms-lan.college.edu

# Public Internet Domain URL
VITE_PUBLIC_HTTPS_URL=https://lms.venilearn.org

# Proxy targets for local development
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:5000
VITE_AI_PROXY_TARGET=http://127.0.0.1:8000

# Optional SSL paths for Vite direct HTTPS
# VITE_SSL_KEY=./certs/privkey.pem
# VITE_SSL_CERT=./certs/fullchain.pem
