# ============================================================
# VeniLearn LMS — College LAN / Wi-Fi Staging (.env.staging)
# ============================================================
VITE_APP_ENV=staging

# Relative API routing through reverse proxy
VITE_API_BASE_URL=/api/v1
VITE_SOCKET_URL=/

# College LAN Internal Domain (Trusted HTTPS resolved via internal DNS / mDNS)
# Example: https://lms-lan.college.edu or https://lms.internal.college.edu
VITE_COLLEGE_LAN_HTTPS_URL=https://lms-lan.college.edu

# Optional Vite direct HTTPS certificate paths (if running without Nginx/Caddy)
# VITE_SSL_KEY=./certs/college-lan-key.pem
# VITE_SSL_CERT=./certs/college-lan.pem

VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:5000
VITE_AI_PROXY_TARGET=http://127.0.0.1:8000

